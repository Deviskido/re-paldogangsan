{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "isolatedModules": false,
    "incremental": false
  },
  "include": [
    "src/lib/**/*.ts",
    "src/types/**/*.ts",
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "legacy"
  ]
}
